{
  "name": "between-us",
  "version": "1.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && cp public/_headers dist/_headers && cp public/_redirects dist/_redirects && node scripts/postbuild.js",
    "deploy:web": "npm run build:web && npx wrangler pages deploy dist --project-name love-between-us --branch main --commit-dirty=true",
    "lint": "eslint src App.tsx",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-locales.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run validate && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "canvas-confetti": "^1.9.4",
    "expo": "^58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.17",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^6.4.3",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "tar": "^6.2.1",
    "selfsigned": ">=2.4.1",
    "uuid": ">=11.1.1",
    "postcss": ">=8.5.3",
    "@xmldom/xmldom": "~0.7.13",
    "braces": ">=3.0.3",
    "micromatch": ">=4.0.8",
    "node-forge": ">=1.3.1",
    "image-size": ">=1.2.1"
  }
}
