{
  "name": "between-us",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && cp public/_headers dist/_headers && cp public/_redirects dist/_redirects && node scripts/postbuild.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"App.tsx\"",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-locales.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "canvas-confetti": "^1.9.4",
    "expo": "~52.0.28",
    "expo-av": "~15.0.2",
    "expo-constants": "~17.0.5",
    "expo-haptics": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-reanimated": "~3.16.1",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "tar": "^6.2.1",
    "selfsigned": ">=2.4.1",
    "uuid": ">=11.1.1",
    "postcss": ">=8.5.3",
    "@xmldom/xmldom": "~0.7.13",
    "braces": ">=3.0.3",
    "micromatch": ">=4.0.8",
    "node-forge": ">=1.3.1",
    "image-size": ">=1.2.1"
  }
}
